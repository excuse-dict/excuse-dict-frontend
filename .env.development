# env 파일 구성
#   .env.development  : next dev 기본값 (커밋됨, 이 파일)
#   .env.production   : next build 기본값 (커밋됨)
#   .env.local        : 개인 로컬 오버라이드 (커밋 안 됨)
# 이 레포에는 NEXT_PUBLIC_ 공개 값만 둔다. reCAPTCHA secret 키 등 비밀 값은 백엔드에만 둔다.
# 변수를 추가하면 .env.development와 .env.production 양쪽에 넣을 것.
NEXT_PUBLIC_API_URL=http://localhost:8081
# Google 공식 reCAPTCHA v2 테스트 키 (항상 통과, 경고 배너 표시)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
